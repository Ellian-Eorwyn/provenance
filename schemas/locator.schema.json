{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenance.dev/upc/1.3.0/schemas/locator.schema.json",
  "title": "UPC Locator",
  "description": "Points into a SPECIFIC representation. A locator is (representation_ref, typed position); a position never stands alone. The value shape is constrained per type by the oneOf below. Only char_range is gate-bearing (anchors a verified quotation, §03); char_range counts Unicode codepoints, 0-based, end-exclusive, into the representation's UTF-8-decoded bytes.",
  "type": "object",
  "required": ["type", "representation_ref"],
  "properties": {
    "type": { "$ref": "../vocab/vocab.json#/$defs/locator_type" },
    "representation_ref": { "type": "string", "minLength": 1 },
    "value": {}
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "char_range" },
        "value": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "type": { "const": "line_range" },
        "value": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "type": { "const": "page" },
        "value": { "type": "integer", "minimum": 1 }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "type": { "enum": ["heading", "section", "css_selector", "xpath", "url"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "type": { "const": "timestamp_range" },
        "value": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "type": { "const": "bbox" },
        "value": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["value"]
    }
  ],
  "additionalProperties": true
}
